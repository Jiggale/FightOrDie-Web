# Docker Compose 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除）

# MySQL root 密码（容器内部使用）
MYSQL_ROOT_PASSWORD=change_me_root_password

# 应用数据库账号密码
MYSQL_DATABASE=fod
MYSQL_USER=fod_app
MYSQL_PASSWORD=change_me_app_password

# JWT 签名密钥（至少 32 字节）
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_bytes
